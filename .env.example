# Elation Health API Configuration
ELATION_CLIENT_ID=your_client_id_here
ELATION_CLIENT_SECRET=your_client_secret_here
ELATION_API_BASE_URL=https://sandbox.elationemr.com/api/2.0
# For production, use: https://app.elationemr.com/api/2.0

# Spruce Health API Configuration
SPRUCE_API_TOKEN=your_spruce_bearer_token_here
SPRUCE_API_BASE_URL=https://api.sprucehealth.com
SPRUCE_CONVERSATION_ID=target_conversation_id_here
SPRUCE_WEBHOOK_SECRET=your_webhook_signing_secret_here

# Schedule Configuration (Daily Analytics Agent)
TIMEZONE=America/New_York
FETCH_HOUR=0
FETCH_MINUTE=1
SEND_HOUR=7
SEND_MINUTE=0

# Output
SUMMARY_OUTPUT_DIR=./output

# Chatbot Configuration
CHATBOT_ENABLED=true
CHATBOT_WEBHOOK_PORT=8080
CHATBOT_WEBHOOK_HOST=0.0.0.0
CHATBOT_WEBHOOK_PATH=/webhook/spruce
CHATBOT_PUBLIC_URL=https://your-domain.com
SPRUCE_ESCALATION_CONVERSATION_ID=team_conversation_id_here
PRACTICE_PHONE=(580) 599-0272
PRACTICE_NAME=Reliant Direct Primary Care
