# Elation Health API Configuration
ELATION_CLIENT_ID=your_client_id_here
ELATION_CLIENT_SECRET=your_client_secret_here
ELATION_API_BASE_URL=https://sandbox.elationemr.com/api/2.0
# For production, use: https://app.elationemr.com/api/2.0

# Spruce Health API Configuration
SPRUCE_API_TOKEN=your_spruce_bearer_token_here
SPRUCE_API_BASE_URL=https://api.sprucehealth.com
SPRUCE_CONVERSATION_ID=target_conversation_id_here
# Optional: Spruce internal endpoint ID for outbound SMS (auto-discovered if omitted)
SPRUCE_INTERNAL_ENDPOINT_ID=

# Schedule Configuration
TIMEZONE=America/New_York
FETCH_HOUR=0
FETCH_MINUTE=1
SEND_HOUR=7
SEND_MINUTE=0

# Checkout Review Request Polling
CHECKOUT_POLL_INTERVAL_MINUTES=5
CHECKOUT_POLL_START_HOUR=7
CHECKOUT_POLL_END_HOUR=19

# Google Review Request Configuration
GOOGLE_REVIEW_URL=https://g.page/r/CWIudlNSwpwpEBM/review
PRACTICE_NAME=Reliant Direct Primary Care
REVIEW_PROCESSED_FILE=./data/processed_checkouts.json

# Output
SUMMARY_OUTPUT_DIR=./output
