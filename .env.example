# Elation Health API Configuration
ELATION_CLIENT_ID=your_client_id_here
ELATION_CLIENT_SECRET=your_client_secret_here
ELATION_API_BASE_URL=https://sandbox.elationemr.com/api/2.0
# For production, use: https://app.elationemr.com/api/2.0

# Spruce Health API Configuration
SPRUCE_API_TOKEN=your_spruce_bearer_token_here
SPRUCE_API_BASE_URL=https://api.sprucehealth.com
SPRUCE_CONVERSATION_ID=target_conversation_id_here

# Optional overrides for Spruce reporting endpoints (defaults shown)
# SPRUCE_CALLS_ENDPOINT=https://api.sprucehealth.com/v1/calls
# SPRUCE_MESSAGES_ENDPOINT=https://api.sprucehealth.com/v1/messages
# SPRUCE_PHONE_NUMBERS_ENDPOINT=https://api.sprucehealth.com/v1/phone_numbers

# Daily Schedule Configuration
TIMEZONE=America/New_York
FETCH_HOUR=0
FETCH_MINUTE=1
SEND_HOUR=7
SEND_MINUTE=0

# Weekly SPRUS Report Configuration
WEEKLY_REPORT_DAY=mon
WEEKLY_REPORT_HOUR=7
WEEKLY_REPORT_MINUTE=0
# WEEKLY_REPORT_CONVERSATION_ID=  # falls back to SPRUCE_CONVERSATION_ID
PHONE_MAPPING_FILE=phone_mapping.json
WEEKLY_REPORT_ENRICH_PROVIDERS=true

# Output
SUMMARY_OUTPUT_DIR=./output
