# Elation Health API Configuration
ELATION_CLIENT_ID=your_client_id_here
ELATION_CLIENT_SECRET=your_client_secret_here
ELATION_API_BASE_URL=https://sandbox.elationemr.com/api/2.0
# For production, use: https://app.elationemr.com/api/2.0

# Spruce Health API Configuration
SPRUCE_API_TOKEN=your_spruce_bearer_token_here
SPRUCE_API_BASE_URL=https://api.sprucehealth.com
SPRUCE_CONVERSATION_ID=target_conversation_id_here

# Schedule Configuration
TIMEZONE=America/New_York
FETCH_HOUR=0
FETCH_MINUTE=1
SEND_HOUR=7
SEND_MINUTE=0

# Output
SUMMARY_OUTPUT_DIR=./output

# ── Voice Assistant Configuration ──────────────────────────────────────────

# Twilio (telephony layer for receiving/handling phone calls)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
TWILIO_TTS_VOICE=Polly.Joanna-Neural
TWILIO_SPEECH_TIMEOUT=auto
TWILIO_SPEECH_LANGUAGE=en-US
TWILIO_GATHER_TIMEOUT=3

# Anthropic Claude API (conversation intelligence)
ANTHROPIC_API_KEY=your_anthropic_api_key
VOICE_ASSISTANT_MODEL=claude-sonnet-4-20250514
VOICE_ASSISTANT_MAX_TOKENS=300
VOICE_ASSISTANT_TEMPERATURE=0.3

# Practice information (used in the assistant's personality)
PRACTICE_NAME=Our Practice
PRACTICE_PHONE=+1XXXXXXXXXX
PRACTICE_ADDRESS=123 Main Street, Suite 100, City, ST 12345
PRACTICE_HOURS=Monday through Friday, 8 AM to 5 PM

# Staff transfer number (where to connect callers who need a human)
STAFF_PHONE_NUMBER=+1XXXXXXXXXX

# Spruce conversation for logging call summaries (separate from analytics)
SPRUCE_VOICE_LOG_CONVERSATION_ID=voice_log_conversation_id_here

# Voice server settings
VOICE_WEBHOOK_BASE_URL=https://your-domain.ngrok-free.app
VOICE_SERVER_HOST=0.0.0.0
VOICE_SERVER_PORT=8000

# Maximum conversation turns before suggesting transfer
VOICE_MAX_TURNS=20
